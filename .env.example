# FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html)
# Server-side only. Never exposed to the browser. Leave unset to use the
# bundled data/fred-snapshot.json fallback.
FRED_API_KEY=
# Plaid Sandbox credentials (https://dashboard.plaid.com/developers/keys)
# Server-side only. Never exposed to the browser. When either is unset, the
# "Connect a test bank" entry point is hidden/disabled and every non-Plaid
# feature keeps working.
PLAID_CLIENT_ID=
PLAID_SECRET=
